# =============================================================================
# autonex-crm-app — frontend environment
#
# This is the complete list. The backend's secrets (DATABASE_URL, JWT_SECRET,
# SMTP_*, OAuth client secrets) belong in autonex-crm-api and must never appear
# in this repo — anything prefixed PUBLIC_ or EXPO_PUBLIC_ is compiled into a
# bundle that ships to the browser and to app stores.
# =============================================================================

# Base URL of the Go gateway (autonex-crm-api).
#
# Inlined into the client bundle by Vite AT BUILD TIME, so changing it requires
# a rebuild, not a restart. The Docker build fails outright when it is unset
# rather than shipping a bundle that silently points at localhost.
#
# Production: https://apidealbridge.autonexai360.com
PUBLIC_API_URL=http://localhost:8080

# Same value, for the Expo app. Read at build time by EAS.
# On a device, localhost is the device itself — use your machine's LAN IP
# (http://192.168.x.x:8080) when running the gateway locally.
EXPO_PUBLIC_API_URL=http://localhost:8080
